    <DTS:Executable
      DTS:refId="Package\Load Clients"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8443A6F3-D0D5-43DE-ADE0-3BE049187B5D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Clients"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="&#xA;&#xA;INSERT INTO tblClient (ClientName)&#xA;SELECT DISTINCT Client&#xA;FROM tblStagingTimesheet&#xA;WHERE Client IS NOT NULL&#xA;AND Client &lt;&gt; 'Client'&#xA;AND Client NOT IN (SELECT ClientName FROM tblClient)&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ExecutedBy"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="128" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Consultants Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{84D3BDF6-588B-4477-9526-666BD6DBE297}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Consultants Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="&#xA;&#xA;    INSERT INTO tblConsultant (FullName, FirstName, LastName)&#xA;    SELECT DISTINCT &#xA;        ConsultantName,&#xA;        LEFT(ConsultantName, CHARINDEX(' ', ConsultantName) - 1),&#xA;        RIGHT(ConsultantName, LEN(ConsultantName) - CHARINDEX(' ', ConsultantName))&#xA;    FROM tblStagingTimesheet&#xA;    WHERE ConsultantName IS NOT NULL&#xA;    AND ConsultantName NOT IN (SELECT FullName FROM tblConsultant)&#xA;&#xA;    " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ExecutedBy"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="128" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Expense Claim Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B4E2E543-9F13-48AB-9B5E-420E1D396776}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Expense Claim Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="&#xA;&#xA;INSERT INTO tblExpenseClaim (&#xA;    ConsultantID,&#xA;    Date,&#xA;    Month,&#xA;    ExpenseDescription,&#xA;    Type,&#xA;    Cost&#xA;)&#xA;SELECT&#xA;    c.ConsultantID,&#xA;    CAST(es.[Date] AS DATE)                    AS [Date],&#xA;    es.Month,&#xA;    es.ExpenseDescription,&#xA;    es.Type,&#xA;    CAST(REPLACE(es.Cost, ',', '.') AS FLOAT)  AS Cost&#xA;FROM tblExpenseStaging es&#xA;INNER JOIN (&#xA;    SELECT ConsultantID, FullName,&#xA;           ROW_NUMBER() OVER (PARTITION BY LTRIM(RTRIM(FullName)) ORDER BY ConsultantID) AS rn&#xA;    FROM tblConsultant&#xA;) c ON c.FullName = es.ConsultantName AND c.rn = 1&#xA;WHERE es.ExpenseDescription IS NOT NULL&#xA;  AND es.ExpenseDescription &lt;&gt; 'Expense Description'&#xA;  AND es.[Date] IS NOT NULL&#xA;  AND es.Type IS NOT NULL&#xA;  AND es.Cost IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM tblExpenseClaim ec&#xA;        WHERE ec.ConsultantID = c.ConsultantID&#xA;          AND ec.Date = CAST(es.[Date] AS DATE)&#xA;          AND ISNULL(ec.ExpenseDescription, '') = ISNULL(es.ExpenseDescription, '')&#xA;          AND ec.Cost = CAST(REPLACE(es.Cost, ',', '.') AS FLOAT)&#xA;  );&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ExecutedBy"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="128" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Leave Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F7F76207-E5F4-4779-B093-EA92AFBAA449}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Leave Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="&#xA;&#xA;INSERT INTO tblLeave (ConsultantID, Date, DayOfWeek, LeaveType, Comments)&#xA;SELECT &#xA;    c.ConsultantID,&#xA;    CAST(s.DateValue AS DATETIME),&#xA;    s.DOfWeek,&#xA;    s.WorkDescription,&#xA;    s.Comments&#xA;FROM tblStagingTimesheet s&#xA;INNER JOIN (&#xA;    SELECT ConsultantID, FullName,&#xA;           ROW_NUMBER() OVER (PARTITION BY LTRIM(RTRIM(FullName)) ORDER BY ConsultantID) AS rn&#xA;    FROM tblConsultant&#xA;) c ON c.FullName = s.ConsultantName AND c.rn = 1&#xA;WHERE s.WorkDescription LIKE '%leave%'&#xA;  AND s.DateValue IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;        SELECT 1 FROM tblLeave l&#xA;        WHERE l.ConsultantID = c.ConsultantID&#xA;          AND l.Date = CAST(s.DateValue AS DATETIME)&#xA;          AND l.LeaveType = s.WorkDescription&#xA;  );&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ExecutedBy"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="128" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Timesheet"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{64F0EDFD-2EBB-4EA3-999F-18235CB6772E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Timesheet"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="INSERT INTO tblTimesheet&#xA;(&#xA;    ConsultantID,&#xA;    WorkDate,&#xA;    ClientID,&#xA;    ClientProjectName,&#xA;    WorkDescription,&#xA;    BillableFlag,&#xA;    Comments,&#xA;    StartTime,&#xA;    EndTime,&#xA;    MinutesWorked,&#xA;    ImportDate,&#xA;    UpdatedAt,&#xA;    SourceTimesheetID&#xA;)&#xA;SELECT&#xA;    src.ConsultantID,&#xA;    src.WorkDate,&#xA;    src.ClientID,&#xA;    src.ClientProjectName,&#xA;    src.WorkDescription,&#xA;    src.BillableFlag,&#xA;    src.Comments,&#xA;    src.StartTime,&#xA;    src.EndTime,&#xA;    src.MinutesWorked,&#xA;    src.ImportDate,&#xA;    src.UpdatedAt,&#xA;    src.TimesheetID&#xA;FROM tblTimesheetEntries src&#xA;WHERE&#xA;    (src.RowSeq = 1 OR src.RowSeq IS NULL)&#xA;    AND NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM tblTimesheet tgt&#xA;        WHERE tgt.SourceTimesheetID = src.TimesheetID&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ExecutedBy"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="128" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Timesheet Entries"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F3A4B500-4830-4987-93C0-7283261B8EF1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Timesheet Entries"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="DECLARE @PerformedBy NVARCHAR(128) = ?;&#xA; &#xA;IF OBJECT_ID('tempdb..#MergeResults') IS NOT NULL DROP TABLE #MergeResults;&#xA; &#xA;CREATE TABLE #MergeResults (&#xA;    ActionTaken     NVARCHAR(10),&#xA;    WasDeletedAfter BIT,&#xA;    WasDeletedBefore BIT&#xA;);&#xA; &#xA;;WITH SourceRows AS (&#xA;    SELECT&#xA;        c.ConsultantID,&#xA;        CAST(src.DateValue AS DATE)                                                AS WorkDate,&#xA;        cl.ClientID,&#xA;        src.ClientProjectName,&#xA;        src.WorkDescription,&#xA;        src.BillableFlag,&#xA;        src.Comments,&#xA;        CAST(src.StartTime AS TIME)                                                AS StartTime,&#xA;        CAST(src.EndTime AS TIME)                                                  AS EndTime,&#xA;        DATEDIFF(MINUTE, CAST('00:00:00' AS TIME), CAST(src.TotalHours AS TIME))   AS MinutesWorked,&#xA;        -- Ordinal position among rows sharing the same Consultant+Date+Start+End,&#xA;        -- ordered by their original row order (StagingID) in the source sheet.&#xA;        -- This is what lets us tell apart &quot;row 9&quot; from other same-slot entries.&#xA;        ROW_NUMBER() OVER (&#xA;            PARTITION BY c.ConsultantID, CAST(src.DateValue AS DATE),&#xA;                         CAST(src.StartTime AS TIME), CAST(src.EndTime AS TIME)&#xA;            ORDER BY src.StagingID&#xA;        ) AS RowSeq&#xA;    FROM (&#xA;        SELECT DISTINCT&#xA;            SheetName, StagingID, ConsultantName, DateValue, DOfWeek, Client,&#xA;            ClientProjectName, WorkDescription, BillableFlag, Comments,&#xA;            TotalHours, StartTime, EndTime&#xA;        FROM tblStagingTimesheet&#xA;        WHERE DateValue IS NOT NULL&#xA;          AND WorkDescription IS NOT NULL&#xA;          AND Comments &lt;&gt; 'Detailed Description of task(s) done'&#xA;          AND WorkDescription &lt;&gt; 'Public Holiday'&#xA;    ) src&#xA;    INNER JOIN (&#xA;        SELECT ConsultantID, FullName,&#xA;               ROW_NUMBER() OVER (PARTITION BY LTRIM(RTRIM(FullName)) ORDER BY ConsultantID) AS rn&#xA;        FROM tblConsultant&#xA;    ) c ON c.FullName = src.ConsultantName AND c.rn = 1&#xA;    INNER JOIN tblClient cl&#xA;        ON cl.ClientName = src.Client&#xA;),&#xA; &#xA;-- Only these (Consultant, Year, Month) combos are &quot;in scope&quot; for this run.&#xA;-- Anything outside this scope in tblTimesheetEntries is left untouched.&#xA;ScopeKeys AS (&#xA;    SELECT DISTINCT ConsultantID, YEAR(WorkDate) AS WorkYear, MONTH(WorkDate) AS WorkMonth&#xA;    FROM SourceRows&#xA;),&#xA; &#xA;TargetInScope AS (&#xA;    SELECT te.*&#xA;    FROM tblTimesheetEntries te&#xA;    INNER JOIN ScopeKeys sk&#xA;        ON sk.ConsultantID = te.ConsultantID&#xA;       AND sk.WorkYear     = YEAR(te.WorkDate)&#xA;       AND sk.WorkMonth    = MONTH(te.WorkDate)&#xA;    WHERE te.IsDeleted = 0   -- already-soft-deleted rows are excluded from matching;&#xA;                             -- a genuine re-add of the same slot inserts fresh, keeping history intact&#xA;)&#xA; &#xA;MERGE TargetInScope AS tgt&#xA;USING SourceRows AS src&#xA;   ON  tgt.ConsultantID = src.ConsultantID&#xA;   AND tgt.WorkDate     = src.WorkDate&#xA;   AND ISNULL(tgt.StartTime, '00:00:00') = ISNULL(src.StartTime, '00:00:00')&#xA;   AND ISNULL(tgt.EndTime,   '00:00:00') = ISNULL(src.EndTime,   '00:00:00')&#xA;   AND ISNULL(tgt.RowSeq, 1)             = src.RowSeq&#xA; &#xA;-- Row still exists, but content changed (e.g. description Training -&gt; Meeting)&#xA;WHEN MATCHED AND (&#xA;        ISNULL(tgt.WorkDescription, '')    &lt;&gt; ISNULL(src.WorkDescription, '')&#xA;     OR ISNULL(tgt.Comments, '')           &lt;&gt; ISNULL(src.Comments, '')&#xA;     OR ISNULL(tgt.ClientProjectName, '')  &lt;&gt; ISNULL(src.ClientProjectName, '')&#xA;     OR ISNULL(tgt.BillableFlag, '')       &lt;&gt; ISNULL(src.BillableFlag, '')&#xA;     OR ISNULL(tgt.ClientID, -1)           &lt;&gt; ISNULL(src.ClientID, -1)&#xA;     OR ISNULL(tgt.MinutesWorked, -1)      &lt;&gt; ISNULL(src.MinutesWorked, -1)&#xA;) THEN&#xA;    UPDATE SET&#xA;        ClientID          = src.ClientID,&#xA;        ClientProjectName = src.ClientProjectName,&#xA;        WorkDescription   = src.WorkDescription,&#xA;        BillableFlag      = src.BillableFlag,&#xA;        Comments          = src.Comments,&#xA;        MinutesWorked     = src.MinutesWorked,&#xA;        RowSeq            = src.RowSeq,&#xA;        UpdatedAt         = GETDATE()&#xA; &#xA;-- Row is new&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (ConsultantID, WorkDate, ClientID, ClientProjectName, WorkDescription,&#xA;            BillableFlag, Comments, StartTime, EndTime, MinutesWorked, RowSeq, UpdatedAt, IsDeleted)&#xA;    VALUES (src.ConsultantID, src.WorkDate, src.ClientID, src.ClientProjectName, src.WorkDescription,&#xA;            src.BillableFlag, src.Comments, src.StartTime, src.EndTime, src.MinutesWorked, src.RowSeq, GETDATE(), 0)&#xA; &#xA;-- Row existed before, in scope, but is missing from this run's file -&gt; soft delete&#xA;WHEN NOT MATCHED BY SOURCE THEN&#xA;    UPDATE SET&#xA;        IsDeleted = 1,&#xA;        DeletedAt = GETDATE()&#xA; &#xA;OUTPUT&#xA;    $action,&#xA;    inserted.IsDeleted,&#xA;    deleted.IsDeleted&#xA;INTO #MergeResults (ActionTaken, WasDeletedAfter, WasDeletedBefore);&#xA; &#xA; &#xA;-- Classify the MERGE's raw $action values into Insert / Update / Soft-Delete,&#xA;-- since a soft-delete is technically an UPDATE statement under the hood.&#xA;DECLARE @RowsInserted INT, @RowsUpdated INT, @RowsDeleted INT, @RowsAffected INT;&#xA; &#xA;SELECT&#xA;    @RowsInserted = SUM(CASE WHEN ActionTaken = 'INSERT' THEN 1 ELSE 0 END),&#xA;    @RowsUpdated  = SUM(CASE WHEN ActionTaken = 'UPDATE' AND WasDeletedAfter = 0 THEN 1 ELSE 0 END),&#xA;    @RowsDeleted  = SUM(CASE WHEN ActionTaken = 'UPDATE' AND WasDeletedAfter = 1 AND ISNULL(WasDeletedBefore,0) = 0 THEN 1 ELSE 0 END)&#xA;FROM #MergeResults;&#xA; &#xA;SET @RowsInserted = ISNULL(@RowsInserted, 0);&#xA;SET @RowsUpdated  = ISNULL(@RowsUpdated, 0);&#xA;SET @RowsDeleted  = ISNULL(@RowsDeleted, 0);&#xA;SET @RowsAffected = @RowsInserted + @RowsUpdated + @RowsDeleted;&#xA; &#xA;IF @RowsAffected &gt; 0&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected, RowsInserted, RowsUpdated, RowsDeleted, PerformedBy)&#xA;    VALUES (&#xA;        'tblTimesheetEntries',&#xA;        'MERGE',&#xA;        'SUCCESS',&#xA;        CONCAT('Timesheet entries synced from staging: ', @RowsInserted, ' inserted, ',&#xA;               @RowsUpdated, ' updated, ', @RowsDeleted, ' soft-deleted'),&#xA;        @RowsAffected,&#xA;        @RowsInserted,&#xA;        @RowsUpdated,&#xA;        @RowsDeleted,&#xA;        @PerformedBy&#xA;    )&#xA;ELSE&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected, RowsInserted, RowsUpdated, RowsDeleted, PerformedBy)&#xA;    VALUES (&#xA;        'tblTimesheetEntries',&#xA;        'MERGE',&#xA;        'NO ACTION',&#xA;        'No inserts, updates, or deletions detected in this run',&#xA;        0, 0, 0, 0,&#xA;        @PerformedBy&#xA;    );&#xA; &#xA;DROP TABLE #MergeResults;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ExecutedBy"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="128" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
