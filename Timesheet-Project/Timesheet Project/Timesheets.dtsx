          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected, RowsInserted, PerformedBy)&#xA;VALUES (&#xA;    'tblTimesheetEntries',&#xA;    'INSERT',&#xA;    'FAILED',&#xA;    'Insert into tblTimesheetEntries failed during SSIS package execution',&#xA;    0,&#xA;    0,&#xA;    ?&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
