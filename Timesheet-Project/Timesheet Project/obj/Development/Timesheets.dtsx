        <DTS:Executable
          DTS:refId="Package\Loop Files\Loop Sheets"
          DTS:CreationName="STOCK:FOREACHLOOP"
          DTS:Description="Foreach Loop Container"
          DTS:DTSID="{BDD0E125-8761-421E-930C-67DCBB3BF5BC}"
          DTS:ExecutableType="STOCK:FOREACHLOOP"
          DTS:LocaleID="-1"
          DTS:ObjectName="Loop Sheets">
