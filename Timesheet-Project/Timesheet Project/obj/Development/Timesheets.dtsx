    <DTS:Executable
      DTS:refId="Package\Load Clients"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8443A6F3-D0D5-43DE-ADE0-3BE049187B5D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Clients"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="DECLARE @RowsInserted INT&#xA;&#xA;INSERT INTO tblClient (ClientName)&#xA;SELECT DISTINCT Client&#xA;FROM tblStagingTimesheet&#xA;WHERE Client IS NOT NULL&#xA;AND Client &lt;&gt; 'Client'&#xA;AND Client NOT IN (SELECT ClientName FROM tblClient)&#xA;&#xA;SET @RowsInserted = @@ROWCOUNT&#xA;&#xA;IF @RowsInserted &gt; 0&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblClient',&#xA;        'INSERT',&#xA;        'SUCCESS',&#xA;        'New clients inserted from staging table',&#xA;        @RowsInserted&#xA;    )&#xA;ELSE&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblClient',&#xA;        'INSERT',&#xA;        'NO ACTION',&#xA;        'No new clients to insert, all already exist',&#xA;        0&#xA;    )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Consultants Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{84D3BDF6-588B-4477-9526-666BD6DBE297}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Consultants Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @RowsInserted INT&#xA;&#xA;INSERT INTO tblConsultant (FullName, FirstName, LastName)&#xA;SELECT DISTINCT &#xA;    ConsultantName,&#xA;    LEFT(ConsultantName, CHARINDEX(' ', ConsultantName) - 1),&#xA;    RIGHT(ConsultantName, LEN(ConsultantName) - CHARINDEX(' ', ConsultantName))&#xA;FROM tblStagingTimesheet&#xA;WHERE ConsultantName IS NOT NULL&#xA;AND ConsultantName NOT IN (SELECT FullName FROM tblConsultant) -- Not In allows for incremental load&#xA;&#xA;-- Capture how many rows were inserted&#xA;SET @RowsInserted = @@ROWCOUNT&#xA;&#xA;-- Logging based on whether rows were actually inserted&#xA;IF @RowsInserted &gt; 0&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblConsultant',&#xA;        'INSERT',&#xA;        'SUCCESS',&#xA;        'New consultants inserted from staging table',&#xA;        @RowsInserted&#xA;    )&#xA;ELSE&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblConsultant',&#xA;        'INSERT',&#xA;        'NO ACTION',&#xA;        'No new consultants to insert, all already exist',&#xA;        0&#xA;    )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Expense Claim Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B4E2E543-9F13-48AB-9B5E-420E1D396776}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Expense Claim Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="DECLARE @RowsInserted INT&#xA;&#xA;INSERT INTO tblExpenseClaim (&#xA;    ConsultantID,&#xA;    ConsultantName,&#xA;    Date,&#xA;    Month,&#xA;    ExpenseDescription,&#xA;    Type,&#xA;    Cost&#xA;)&#xA;SELECT&#xA;    c.ConsultantID,&#xA;    es.ConsultantName,&#xA;    CAST(es.[Date] AS DATE)                    AS [Date],&#xA;    es.Month,&#xA;    es.ExpenseDescription,&#xA;    es.Type,&#xA;    CAST(REPLACE(es.Cost, ',', '.') AS FLOAT)  AS Cost&#xA;FROM tblExpenseStaging es&#xA;INNER JOIN tblConsultant c&#xA;    ON c.FullName = es.ConsultantName&#xA;WHERE es.ExpenseDescription IS NOT NULL&#xA;  AND es.ExpenseDescription &lt;&gt; 'Expense Description'&#xA;  AND es.[Date] IS NOT NULL&#xA;  AND es.Type IS NOT NULL&#xA;  AND es.Cost IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM tblExpenseClaim ec&#xA;        WHERE ec.ConsultantName = es.ConsultantName&#xA;          AND ec.Date = CAST(es.[Date] AS DATE)&#xA;          AND ec.ExpenseDescription = es.ExpenseDescription&#xA;          AND ec.Cost = CAST(REPLACE(es.Cost, ',', '.') AS FLOAT)&#xA;  )&#xA;&#xA;SET @RowsInserted = @@ROWCOUNT&#xA;&#xA;IF @RowsInserted &gt; 0&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblExpenseClaim',&#xA;        'INSERT',&#xA;        'SUCCESS',&#xA;        'New expense claims inserted from staging table',&#xA;        @RowsInserted&#xA;    )&#xA;ELSE&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblExpenseClaim',&#xA;        'INSERT',&#xA;        'NO ACTION',&#xA;        'No new expense claims to insert, all already exist',&#xA;        0&#xA;    )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Leave Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F7F76207-E5F4-4779-B093-EA92AFBAA449}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Leave Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @RowsInserted INT&#xA;&#xA;&#xA;INSERT INTO tblLeave (ConsultantID, ConsultantName, Date, DayOfWeek, LeaveType, Comments)&#xA;SELECT &#xA;    c.ConsultantID,&#xA;    s.ConsultantName,&#xA;    CAST(s.DateValue AS DATETIME),&#xA;    s.DOfWeek,&#xA;    s.WorkDescription,&#xA;    s.Comments&#xA;FROM tblStagingTimesheet s&#xA;JOIN tblConsultant c ON s.ConsultantName = c.FullName&#xA;WHERE s.WorkDescription LIKE '%leave%'&#xA;AND s.DateValue IS NOT NULL&#xA;AND NOT EXISTS (&#xA;    SELECT 1 FROM tblLeave l&#xA;    WHERE l.ConsultantID = c.ConsultantID&#xA;    AND l.Date = CAST(s.DateValue AS DATETIME)&#xA;    AND l.LeaveType = s.WorkDescription&#xA;)&#xA;&#xA;SET @RowsInserted = @@ROWCOUNT&#xA;&#xA;IF @RowsInserted &gt; 0&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblLeave',&#xA;        'INSERT',&#xA;        'SUCCESS',&#xA;        'New leave records inserted from staging table',&#xA;        @RowsInserted&#xA;    )&#xA;ELSE&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblLeave',&#xA;        'INSERT',&#xA;        'NO ACTION',&#xA;        'No new leave records to insert, all already exist',&#xA;        0&#xA;    )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load Timesheet Entries"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F3A4B500-4830-4987-93C0-7283261B8EF1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Timesheet Entries"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{30655B4E-A297-4EC4-AD0B-437991C75F52}"
          SQLTask:SqlStatementSource="DECLARE @RowsInserted INT&#xA;&#xA;INSERT INTO tblTimesheetEntries (&#xA;    ConsultantID,&#xA;    WorkDate,&#xA;    Client,&#xA;    ClientProjectName,&#xA;    WorkDescription,&#xA;    BillableFlag,&#xA;    Comments,&#xA;    StartTime,&#xA;    EndTime,&#xA;    TotalMinutes&#xA;)&#xA;SELECT&#xA;    c.ConsultantID,&#xA;    CAST(st.DateValue AS DATE)                                              AS WorkDate,&#xA;    st.Client,&#xA;    st.ClientProjectName,&#xA;    st.WorkDescription,&#xA;    st.BillableFlag,&#xA;    st.Comments,&#xA;    CAST(st.StartTime AS TIME)                                              AS StartTime,&#xA;    CAST(st.EndTime AS TIME)                                                AS EndTime,&#xA;    DATEDIFF(MINUTE, CAST('00:00:00' AS TIME), CAST(st.TotalHours AS TIME)) AS TotalMinutes&#xA;FROM tblStagingTimesheet st&#xA;INNER JOIN tblConsultant c&#xA;    ON c.FullName = st.ConsultantName&#xA;WHERE st.DateValue IS NOT NULL&#xA;  AND st.WorkDescription IS NOT NULL&#xA;  AND st.Comments &lt;&gt; 'Detailed Description of task(s) done'&#xA;  AND st.WorkDescription &lt;&gt; 'Public Holiday'&#xA;  AND NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM tblTimesheetEntries te&#xA;        WHERE te.ConsultantID = c.ConsultantID&#xA;          AND te.WorkDate = CAST(st.DateValue AS DATE)&#xA;          AND te.StartTime = CAST(st.StartTime AS TIME)&#xA;          AND te.EndTime = CAST(st.EndTime AS TIME)&#xA;  )&#xA;&#xA;SET @RowsInserted = @@ROWCOUNT&#xA;&#xA;IF @RowsInserted &gt; 0&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblTimesheetEntries',&#xA;        'INSERT',&#xA;        'SUCCESS',&#xA;        'New timesheet entries inserted from staging table',&#xA;        @RowsInserted&#xA;    )&#xA;ELSE&#xA;    INSERT INTO tblAuditLog (TableName, Action, StatusCode, StatusMessage, RowsAffected)&#xA;    VALUES (&#xA;        'tblTimesheetEntries',&#xA;        'INSERT',&#xA;        'NO ACTION',&#xA;        'No new timesheet entries to insert, all already exist',&#xA;        0&#xA;    )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Loop Files"
